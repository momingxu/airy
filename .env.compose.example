# Published image. Change to airy:local when using a locally built image.
AIRY_IMAGE=ghcr.io/momingxu/airy:latest

# Host address and port exposed by Docker Compose.
AIRY_BIND_ADDRESS=0.0.0.0
AIRY_PORT=8096
AIRY_TIMEZONE=Asia/Shanghai

# Absolute host path containing the albums. It is mounted as /mnt/library.
AIRY_MEDIA_PATH=/srv/airy/photos

# PostgreSQL settings used only inside the Compose project.
AIRY_POSTGRES_DB=airy
AIRY_POSTGRES_USER=airy
AIRY_POSTGRES_PASSWORD=replace-with-a-long-random-password

