# HTTP server
PORT=8096

# Optional direct HTTPS. Configure both files to serve HTTPS on PORT. Plain HTTP
# requests on the same port are redirected to the matching HTTPS URL.
# The certificate must include the hostname or IP used by clients.
# TLS_CERT_FILE=/etc/airy/server.crt
# TLS_KEY_FILE=/etc/airy/server.key

# Without any DB_* configuration, SQLite uses ./airy.db (Docker: /data/airy.db).
# Existing PostgreSQL DB_* settings still select postgres when DB_DRIVER is omitted.
# Set DB_DRIVER explicitly when supplying a custom SQLite DB_DSN.
# DB_DRIVER=postgres

# Either set a complete PostgreSQL connection string...
# DB_DSN=host=localhost port=5432 user=postgres password=postgres dbname=airy sslmode=disable

# ...or configure the connection one field at a time.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=airy
# DB_SSLMODE=disable

# Or use a local SQLite database (no database server required).
# DB_DRIVER=sqlite
# DB_DSN=file:airy.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)

# Media scanning. Add resource libraries from the web settings page. In the
# Docker image, every non-hidden direct child directory under /mnt is registered
# automatically. The scanner never writes, moves, or deletes original files.
FFMPEG_PATH=/absolute/path/to/ffmpeg
FFPROBE_PATH=/absolute/path/to/ffprobe

